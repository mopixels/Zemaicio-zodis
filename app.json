{
  "expo": {
    "name": "Žemaičio žodis",
    "slug": "zemaiciozodis",
    "platforms": [
      "android"
    ],
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./img/icon.png",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.mopixels.zemaiciozodis",
      "versionCode": 4,
      "permissions": [
        "VIBRATE",
        "NOTIFICATIONS"
      ]
    },
    "description": "",
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./img/icon.png"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./img/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ]
  }
}
